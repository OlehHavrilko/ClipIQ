# ClipIQ — Environment Variables
# Copy to .env and fill in values

# Server / Domain
DOMAIN=188.137.227.70
BASE_URL=http://188.137.227.70

# Redis
REDIS_URL=redis://redis:6379/0

# Storage
TEMP_DIR=/app/storage/temp
FILE_TTL_SECONDS=3600
MAX_FILE_SIZE_MB=500

# Worker
MAX_PARALLEL_JOBS=5

# Platforms (comma-separated)
ALLOWED_PLATFORMS=tiktok,instagram,youtube,twitter,reddit

# CORS (comma-separated origins)
CORS_ORIGINS=http://188.137.227.70

# Next.js public API URL (proxied through Caddy)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BASE_URL=http://188.137.227.70
